# Google AI Studio(https://aistudio.google.com/apikey)에서 키를 받아 .env.local에 넣는다.
# 반드시 결제가 연결된 '유료 등급' 키를 쓴다(무료 등급은 입력이 구글 서비스 개선에 쓰일 수 있다. 학생 데이터를 다루므로 금지).
# 키가 없으면 목업 모드로 돌아가서, AI 없이도 전체 흐름을 볼 수 있다.
GEMINI_API_KEY=
# 주변 인물·사건 서술용(저렴한 모델)과 '나'·대화용(조금 더 좋은 모델)
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_SMART_MODEL=gemini-3.5-flash

# 고용24 Open API(서비스마다 키가 따로 나온다). 없어도 앱은 돌아간다.
# 키를 넣고  npx tsx@4.19.2 --tsconfig tsconfig.json scripts/sync-jobdata.ts  를 실행하면 근거 자료가 저장된다.
WORK24_KEY_WANTED=
WORK24_KEY_TRAINING=
WORK24_KEY_MAJOR=
WORK24_KEY_PROGRAM=
WORK24_KEY_CODE=
WORK24_KEY_DUTY=
WORK24_KEY_JOB=

# 커리어넷 Open API 키. /deepen의 직업가치관검사(대학생·일반)용. 없으면 그 탭에 안내만 뜬다.
CAREERNET_KEY=

# Supabase(로그인·결과 저장). 없으면 로그인 버튼이 안 보이고 앱은 브라우저 저장만으로 돈다.
# Supabase 대시보드 > Project Settings > API 에서 복사. 설정 방법은 README '1-1. 로그인·DB'.
# URL과 anon 키는 브라우저에 나가도 되는 값이다(데이터는 RLS가 막는다).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role 키는 RLS를 건너뛴다. 서버에서만 쓴다. 절대 NEXT_PUBLIC_를 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=
