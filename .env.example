# Google AI Studio(https://aistudio.google.com/apikey)에서 키를 받아 .env.local에 넣는다.
# 실제 학생이 쓰는 배포본은 결제가 연결된 '유료 등급' 키만(무료 등급은 입력이 구글 서비스 개선에 쓰일 수 있다).
# 개발은 무료 등급 키도 된다. 가상 데이터만 넣고, 모델마다 하루 20번 정도 한도가 있다.
# 키가 없으면 목업 모드로 돌아가서, AI 없이도 전체 흐름을 볼 수 있다.
GEMINI_API_KEY=
# 키 등급. free면 AI 판단을 3.5 Flash-Lite 하나로, 한 번에 하나씩, 호출 사이 4.5초, 429면 기다렸다가 최대 3번 다시 시도(발표·실사용은 paid).
GEMINI_TIER=paid
# free일 때만: 한도에 걸리면 넘어갈 키. 한도는 프로젝트마다라 같은 프로젝트 키는 소용없다. 배포에는 넣지 않는다.
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# 주변 인물·사건 서술용(저렴한 모델)과 '나'·대화용(조금 더 좋은 모델)
# 맨 앞에 쓸 모델(비우면 기본). 한도·무응답이면 lib/llm.ts의 순서대로 다음 모델로 넘어간다.
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_SMART_MODEL=gemini-3.6-flash

# 고용24 Open API(서비스마다 키가 따로 나온다). 없어도 앱은 돌아간다.
# 키를 넣고  npx tsx@4.19.2 --tsconfig tsconfig.json scripts/sync-jobdata.ts  를 실행하면 근거 자료가 저장된다.
WORK24_KEY_WANTED=
WORK24_KEY_TRAINING=
WORK24_KEY_MAJOR=
WORK24_KEY_PROGRAM=
WORK24_KEY_CODE=
WORK24_KEY_DUTY=
WORK24_KEY_JOB=

# 커리어넷 Open API 키. /deepen의 직업가치관검사(대학생·일반)용. 없으면 그 탭에 안내만 뜬다.
CAREERNET_KEY=

# Supabase(로그인·결과 저장). 없으면 로그인 버튼이 안 보이고 앱은 브라우저 저장만으로 돈다.
# Supabase 대시보드 > Project Settings > API 에서 복사. 설정 방법은 README '1-1. 로그인·DB'.
# URL과 anon 키는 브라우저에 나가도 되는 값이다(데이터는 RLS가 막는다).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role 키는 RLS를 건너뛴다. 서버에서만 쓴다. 절대 NEXT_PUBLIC_를 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# 토큰 충전(토스페이먼츠 테스트 결제, 3단계). 비우면 충전 버튼이 꺼진다.
# 개발자센터(developers.tosspayments.com) > API 키 > '결제위젯 연동 키'의 테스트 키(test_gck_… / test_gsk_…).
# 두 키는 같은 세트여야 한다. 테스트 키라 실제 돈은 나가지 않는다. 라이브 키(live_…)는 넣지 않는다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 체크인 메일(선택). 없으면 메일을 안 보낸다. CRON_SECRET은 Vercel Cron 인증.
CRON_SECRET=
RESEND_API_KEY=
CHECKIN_MAIL_FROM=
# 등장인물별 AI 호출(선택). 1이면 큰 갈림길마다 인물별로 호출해 원가가 늘어난다.
NPC_AGENTS=
